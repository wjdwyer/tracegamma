\name{tail_rate_defect}
\alias{tail_rate_defect}
\title{Tail-rate defect}
\usage{tail_rate_defect(lam)}
\description{
\eqn{\delta = 1 - (p_3/p_2)/\max\lambda}, in \eqn{[0,1)}, zero at both the
equal-eigenvalue and single-dominant limits.
}
\arguments{
\item{lam}{eigenvalues.}
}
\value{A single number.}
