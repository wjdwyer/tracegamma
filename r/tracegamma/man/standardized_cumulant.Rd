\name{standardized_cumulant}
\alias{standardized_cumulant}
\title{Standardized cumulant of a generalized chi-square}
\usage{standardized_cumulant(lam, r)}
\description{
\eqn{\gamma_{r-2} = \kappa_r/\kappa_2^{r/2}} using
\eqn{\kappa_r = 2^{r-1}(r-1)!\,p_r}.
}
\arguments{
\item{lam}{eigenvalues.}
\item{r}{order, an integer at least 2.}
}
\value{A single number.}
